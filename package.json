{
  "name": "wechat-ilink-bridge-hardened",
  "version": "0.3.1",
  "private": false,
  "type": "module",
  "description": "Hardened fork of DONGH4O/wechat-ilink-bridge (MIT). Local WeChat iLink Bridge CLI for Agent-safe fetch, send, state, and media handoff workflows.",
  "keywords": [
    "wechat",
    "ilink",
    "bot",
    "cli",
    "agent",
    "hardened"
  ],
  "bin": {
    "wxb": "src/cli/index.js",
    "wxb-mcp": "src/mcp/index.js"
  },
  "files": [
    "src/",
    "skills/",
    "docs/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/unit",
    "pack:dry-run": "npm pack --dry-run",
    "spike": "node scripts/protocol-spike.js",
    "spike:normalize": "node scripts/protocol-spike.js normalize"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Geokkk/wechat-ilink-bridge-hardened.git"
  },
