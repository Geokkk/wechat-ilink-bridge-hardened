#!/usr/bin/env bash
# check-secrets - Scan workspace for leaked secrets before push
# 
# Usage: ./scripts/check-secrets
# 
# This script scans the working tree for patterns that look like:
# - Real bot tokens (not test/mock values)
# - Real context tokens (not test/mock values)
# - Real AES keys (not test/mock values)
# - Real CDN signed URLs
# - State directory paths in committed files
#
# Exit code: 0 = clean, 1 = potential secrets found

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"

cd "$PROJECT_ROOT"

echo "Scanning for potential secrets in tracked files..."

# Only scan files that would be committed (respect .gitignore)
# Exclude: test files, docs, scripts, configs, fixtures
EXCLUDE_PATTERNS=(
    "test/"
    "docs/"
    "scripts/"
    ".github/"
    "*.md"
    "LICENSE"
    "CHANGELOG.md"
    ".gitignore"
    ".npmignore"
    ".env.example"
    "package.json"
    "package-lock.json"
)

# Build git ls-files command with exclusions
GIT_LS_CMD="git ls-files"
for pattern in "${EXCLUDE_PATTERNS[@]}"; do
    GIT_LS_CMD+=" | grep -v \"^${pattern}\""
done

# Patterns that indicate REAL secrets (not test fixtures)
# These patterns look for actual secret VALUES, not just keywords
SECRET_PATTERNS=(
    # Real bot token format: typically long alphanumeric strings
    # "bot_token.*[a-zA-Z0-9]{32,}"
    
    # Real context token format
    # "context_token.*[a-zA-Z0-9]{32,}"
    
    # Real AES key: 32 hex chars or base64 16 bytes
    # "[a-f0-9]{32}"
    
    # CDN signed URLs with actual signatures
    # "novac2c\.cdn\.weixin\.qq\.com.*[?&](sign|token|key)="
    
    # Private keys
    "-----BEGIN (RSA|EC|OPENSSH) PRIVATE KEY-----"
    
    # AWS/GCP/Azure keys
    "AKIA[0-9A-Z]{16}"
    "AIza[0-9A-Za-z\\-_]{35}"
)

# For now, check for obviously real secret values in tracked source files
# (not test files, not docs, not configs)
TRACKED_SOURCES=$(git ls-files 'src/**' 'scripts/*.sh' 'scripts/*.ps1' 2>/dev/null | grep -v "test/" || true)

if [[ -n "$TRACKED_SOURCES" ]]; then
    echo "Checking tracked source files for real secret values..."
    
    FOUND=0
    
    # Check for private keys
    if echo "$TRACKED_SOURCES" | xargs grep -l "-----BEGIN.*PRIVATE KEY-----" 2>/dev/null; then
        echo "  ⚠️  Private key found in tracked source file"
        FOUND=1
    fi
    
    # Check for AWS keys
    if echo "$TRACKED_SOURCES" | xargs grep -l "AKIA[0-9A-Z]\\{16\\}" 2>/dev/null; then
        echo "  ⚠️  AWS access key found in tracked source file"
        FOUND=1
    fi
    
    # Check for Google API keys
    if echo "$TRACKED_SOURCES" | xargs grep -l "AIza[0-9A-Za-z\\-_]\\{35\\}" 2>/dev/null; then
        echo "  ⚠️  Google API key found in tracked source file"
        FOUND=1
    fi
    
    # Check for real 32-char hex strings (potential AES keys) in source files
    # Exclude obvious test fixtures
    if echo "$TRACKED_SOURCES" | xargs grep -E "[a-f0-9]{32}" 2>/dev/null | grep -v "test" | grep -v "mock" | grep -v "fixture" | grep -v "example" | grep -v "00000000000000000000000000000000" | grep -v "ffffffffffffffffffffffffffffffff"; then
        echo "  ⚠️  Potential real AES key (32 hex chars) in tracked source file"
        FOUND=1
    fi
    
    if [[ $FOUND -eq 1 ]]; then
        echo ""
        echo "❌ Potential REAL secrets detected in tracked source files!"
        exit 1
    fi
fi

# Also check that .env files are not tracked
if git ls-files --error-unmatch ".env" 2>/dev/null; then
    echo "❌ .env file is tracked by git (should be in .gitignore)"
    exit 1
fi

# Check that state directories are ignored
for dir in ".wxb" "wxb" "inbox" "accounts"; do
    if git ls-files --error-unmatch "$dir" 2>/dev/null; then
        echo "❌ State directory '$dir' is tracked by git (should be in .gitignore)"
        exit 1
    fi
done

# Check that no .stdout.json files are tracked
if git ls-files "*.stdout.json" 2>/dev/null | grep -q .; then
    echo "❌ *.stdout.json files are tracked by git (should be in .gitignore)"
    exit 1
fi

echo "✅ No real secrets found in tracked files"
echo "✅ .env, state directories, and stdout captures are properly ignored"
exit 0